float fValue
int iMenu
int iSubmenu
int iOption
array_var aJSON

Begin Function {fValue, iMenu, iSubmenu, iOption, aJSON}

	SetOnKeyDownEventHandler (CompileScript "Freelook\OnKeyDown.gek") 0
	SetOnKeyUpEventHandler (CompileScript "Freelook\OnKeyUp.gek") 0
	if eval fValue > 0
		SetOnKeyDownEventHandler (CompileScript "Freelook\OnKeyDown.gek") 1 fValue
		SetOnKeyUpEventHandler (CompileScript "Freelook\OnKeyUp.gek") 1 fValue
	endif

	aJSON = ar_Null

End